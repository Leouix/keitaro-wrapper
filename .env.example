# Настоящий ключ знает только Лев — в .env, не в коде и не в репо.
# Дефолт: если ключ не задан здесь, он вводится через UI и хранится
# в файле .keitaro_api_key (0600) в корне проекта.
KEITARO_API_KEY=paste-real-key-here

KEITARO_BASE_URL=https://tlgk.host
# Единственный путь API: legacy /admin_api/v1, работает без белого списка IP.
KEITARO_API_BASE=https://tlgk.host/admin_api/v1

KEITARO_TIMEOUT=10.0
KEITARO_RETRIES=1
DATABASE_URL=sqlite:///./keitaro_wrapper.db
